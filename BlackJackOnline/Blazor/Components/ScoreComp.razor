@using BlackJackOnline.Models;
@using Microsoft.AspNetCore.Components
@code {
    [Parameter]
    public GameEnums.GameState State { get; set; }

    [Parameter]
    public Person Player { get; set; }
}

@if (State == GameEnums.GameState.InProgress
    || State == GameEnums.GameState.Dealing
    || State == GameEnums.GameState.Insurance
    || State == GameEnums.GameState.Payout && Player != null)
{

    <h1 class="display-3 text-info">@Player.visibleScore</h1>
}
