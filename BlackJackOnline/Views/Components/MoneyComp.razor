@using BlackJack.Models;
@code {
    [Parameter]
    public decimal Funds { get; set; }

    [Parameter]
    public decimal Change { get; set; }
}

@{
    string cssClass = "h1Positive";

    if (Funds < 100 && Funds >= 50)
        cssClass = "h1Neutral";
    if (Funds < 50)
        cssClass = "h1Negative";

    string changeDisplay = "+$" + Change;
    string changeCss = "h1Positive";

    if (Change < 0M)
    {
        changeDisplay = "-$" + (Change * -1);
        changeCss = "h1Negative";
    }
}

<span class="display-3 @cssClass">$@Funds</span>
@if (Change != 0)
{
    <div class="changeComp">
    <span class="display-3 @changeCss">@changeDisplay</span>
    </div>
}
