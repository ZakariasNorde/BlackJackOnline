@using BlackJackOnline.Models;

@code {
    [Parameter]
    public GameEnums.GameState State { get; set; }

    [Parameter]
    public decimal Bet { get; set; }
}

@if (State == GameEnums.GameState.Dealing
   || State == GameEnums.GameState.DealingSecond
   || State == GameEnums.GameState.DealingThird
   || State == GameEnums.GameState.DealingFourth
   || State == GameEnums.GameState.DealingLast)
{
    <h1 class="h1Neutral">Dealing...</h1>
}
@if (State == GameEnums.GameState.InProgress)
{
    <h1 class="h1Neutral">$@Bet</h1>
}
@if (State == GameEnums.GameState.Shuffling)
{
    <h1 class="h1Neutral">Shuffling...</h1>
}
