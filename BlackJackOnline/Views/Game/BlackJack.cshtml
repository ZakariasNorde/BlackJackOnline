@model Game
@using BlackJackOnline.Models;
@using BlackJackOnline.Views.Components;
<head>
    <link rel="stylesheet" href="~/css/blackjack.css" asp-append-version="true" />
</head>
<form method="post" asp-action="BlackJack" id="actForm">   
        @if (Model.state == GameEnums.GameState.DealerTurn)
        {
        <script>
            setTimeout(function () {autoSubmitForm('dealerTurn');}, 1000);
        </script>

        }
        @if (Model.state == GameEnums.GameState.DealingSecond)
        {
        <script>
            setTimeout(function () {autoSubmitForm('dealingSecond');}, 1000);
        </script>

        }
        @if (Model.state == GameEnums.GameState.DealingThird)
        {
        <script>
            setTimeout(function () {autoSubmitForm('dealingThird');}, 1000);
        </script>
        }
        @if (Model.state == GameEnums.GameState.DealingFourth)
        {
            <script>
                setTimeout(function () { autoSubmitForm('dealingFourth'); }, 1000);
            </script>

        }
        @if (Model.state == GameEnums.GameState.DealingLast)
        {
            <script>
                setTimeout(function () { autoSubmitForm('dealingLast'); }, 1000);
            </script>

        }
        
<div class="row">
    <div class="col">
        <div>
            @* @{
                int cardCount = Model.dealer.Deck.Count + 1;
            }
            @while (cardCount > 0)
            {
                <div class="blackjack-drawdeck">
                    <img src="~/images/pokercards/cardbackfinal.png" />
                </div>
                cardCount -= 13;
            } *@
        </div>
    </div>
    <div class="col">
            <div>
                @if (Model.dealer != null)
                {
                    <component type="typeof(ScoreComp)" render-mode="ServerPrerendered" param-State="Model.state" param-score="Model.dealer.visibleScore" param-HasLost="false"/>

                }
                @foreach (var card in Model.dealer.Hand)
                {

                    @if (card.IsVisible)
                    {
                        string imageSrc = $"{@Url.Content("~/images/pokercards/")}{card.ImageName.ToLower()}";
                        <img class="blackjack-card" src=@imageSrc />
                    }
                    else
                    {
                        <img class="blackjack-card " src="~/images/pokercards/CardBackFinal.png" />
                    }
                    
                }
            </div>
    </div>
    @* <div class="col-3">
            @if (Model.dealer != null)
            {
                <component type="typeof(ScoreComp)" render-mode="ServerPrerendered" param-State="Model.state" param-score="Model.dealer.visibleScore" />
                
            }
    </div> *@
</div>

<div class="row">
    <div class="col">
            <div class="moneyComp"> 
                <component type="typeof(MoneyComp)" render-mode="ServerPrerendered" param-Funds="Model.player.Funds" param-Change="Model.player.Change"/>
            </div>
    </div>
    <div class="col">
        @if (Model.state == GameEnums.GameState.Betting)
        {
            @if (Model.player.Funds < 10 & Model.hands.Count < 4)
            {
                <span class="h1Negative">Out of money!</span>
            }
                @if (Model.player.Funds >= 10 & Model.hands.Count < 4)
            {
         
                <button type="submit" name="changed" value="bet10" class="btn btn-primary" id="betButton10">
                             Bet $10
                </button>

            }
                @if (Model.player.Funds >= 20 & Model.hands.Count < 4)
            {
                <button type="submit" name="changed" value="bet20" class="btn btn-primary" id="betButton20">
                    Bet $20
                </button>

            }
                @if (Model.player.Funds >= 50 & Model.hands.Count < 4)
            {
                    <button type="submit" name="changed" value="bet50" class="btn btn-primary" id="betButton50">
                    Bet $50
                </button>

                }
                @if (Model.hands.Count >= 4)
                {
                    <h3 class="h3Black"> Max amount of hands </h3>
                }
                if (Model.hands.Count != 0)
                {
                    for (int i = 0; i < Model.hands.Count; i++)
                    {
                        var handNumb = i + 1;
                        var idString = "hand" + handNumb;
                        var bet = Model.hands[i].Bet;
                        
                        <div class="BetBox" id="@idString">
                            <h3> Hand @handNumb </h3>
                            <h3> Bets @bet $</h3>
                        </div>
                    }
                }
                @if (Model.hands.Count != 0)
                {
                <button type="submit" name="changed" value="finalizeBets" class="btn btn-primary" id="finalizeBets"> 
                        Finalize Bets
                </button>
                }
        }

        @* @if (Model.state == GameEnums.GameState.Payout)
        {
                @if (Model.player.hasBlackJack
               && (Model.player.visibleScore > Model.dealer.visibleScore || Model.dealer.isBusted))
                {
                    <h1 class="h1Positive">Blackjack!</h1>
                }
                else if (Model.player.isBusted)
                {
                    <h1 class="h1Negative">Busted</h1>
                }
                else if (Model.dealer.isBusted || Model.player.visibleScore > Model.dealer.visibleScore)
                {
                    <h1 class="h1Positive">You Win!</h1>
                }
                else if (Model.dealer.visibleScore > Model.player.visibleScore)
                {
                    <h1 class="h1Negative"> Dealer Wins</h1>
                }
                else if (Model.player.visibleScore == Model.dealer.visibleScore)
                {
                    <h1 class="h1Neutral">Push</h1>
                }
        } *@
        @if (Model.state == GameEnums.GameState.Dealing
        || Model.state == GameEnums.GameState.Shuffling
        || Model.state == GameEnums.GameState.InProgress
        || Model.state == GameEnums.GameState.DealingSecond
        || Model.state == GameEnums.GameState.DealingThird
        || Model.state == GameEnums.GameState.DealingFourth
        || Model.state == GameEnums.GameState.DealingLast)
        {
            
                @(
                    await Html.RenderComponentAsync<MessageComp>(RenderMode.Server, new
                    {
                        State = Model.state,
                        Bet = Model.player.Bet 
                    })
                    )

        }
    </div>
</div>

<div class="row">
    <div class="col">
        @if (Model.state == GameEnums.GameState.NotStarted || Model.player.Funds < 10)
        {
            <button type="submit" name="changed" value="start" class="btn btn-secondary" id="btn-start">
            Start Game!
            </button>
            
        }
        @if (!Model.player.isBusted
        && Model.state == GameEnums.GameState.InProgress
        && !Model.player.Standing)
        {
            
           
            @* @if (Model.dealer.HasAceShowing && !Model.player.HasInsurance)
            {
                <br />
                <button type="submit" name="changed" value="insurance" class="btn btn-warning" id="btn-Insurance">
                    Insurance ($@(Model.player.Bet / 2))
                </button>
               
            } *@

            }
        @if (Model.state == GameEnums.GameState.Payout)
        {
            <button type="submit" name="changed" value="start" class="btn btn-secondary" id="btn-NewHand">
                Keep Going!
            </button>
            @if (User.Identity.IsAuthenticated){
                <button type="submit" name="changed" value="quit" class="btn btn-secondary" id="btn-NewHand">
                    Save and quit
                </button>
            }
        }
    </div>
    @* each player hand *@
    @if (Model.state != GameEnums.GameState.Betting)
        {
            @for (int handIndex = 0; handIndex < Model.hands.Count; handIndex++)
            {
                var hand = Model.hands[handIndex];
                <div class="col">

                    <component type="typeof(ScoreComp)" render-mode="ServerPrerendered" param-State="Model.state" param-score="hand.visibleScore" param-HasLost="hand.HasLost" />
                    <component type="typeof(HandMoneyComp)" render-mode="ServerPrerendered" param-Bet="hand.Bet" param-HasLost="hand.HasLost"/>
                    <div class="buttonsContainer">
                    @if (!hand.isBusted
                     && Model.state == GameEnums.GameState.InProgress
                     && !hand.Standing && hand.ActiveHand)
                        {

                            var standString = "stand" + " " + handIndex;
                            var hitString = "hit" + " " + handIndex;

                            <button type="submit" name="changed" value="@(standString)" class="btn btn-primary" id="btn-Stand">
                                Stand
                            </button>
                            <button type="submit" name="changed" value="@(hitString)" class="btn btn-primary" id="btn-Hit">
                                Hit
                            </button>

                            @if (hand.Hand.Count == 2 && Model.player.Funds >= Model.player.Bet * 2)
                            {
                                var doubleString = "double" + " " + handIndex;
                                <br />
                                <button type="submit" name="changed" value="@(doubleString)" class="btn btn-warning" id="btn-Double">
                                    Double Down
                                </button>

                            }
                            @if (hand.canSplit && Model.player.Funds >= Model.player.Bet * 2)
                            {
                                var splitString = "split" + " " + handIndex;
                                <br />
                                <button type="submit" name="changed" value="@(splitString)" class="btn btn-warning" id="btn-Insurance">
                                    Split
                                </button>
                            }
                        }
                    </div>
                    <div class="cardContainer">
                    @foreach (var card in hand.Hand)
                    {
                        
                        @if (card.IsVisible)
                        {
                            string imageSrc = $"{@Url.Content("~/images/pokercards/")}{card.ImageName.ToLower()}";
                            <img class="blackjack-card" src=@imageSrc />

                        }
                        else
                        {
                            <img class="blackjack-card " src="~/images/pokercards/CardBackFinal.png" />
                        }
                    }
                    </div>
                    

                </div>
            }
        }
        @* <div class="col-3">
            <component type="typeof(ScoreComp)" render-mode="ServerPrerendered" param-State="Model.state" param-score="Model.player.visibleScore" />
    </div> *@
    </div>
    
</form>