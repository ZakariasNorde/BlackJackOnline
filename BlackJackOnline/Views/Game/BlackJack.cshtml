@model Game
@using BlackJackOnline.Models;
@using BlackJackOnline.Views.Components;
<form method="post" asp-action="BlackJack">   
   
<div class="row">
    <div class="col-3">
        <div>
            @* @{
                int cardCount = Model.dealer.Deck.Count + 1;
            }
            @while (cardCount > 0)
            {
                <div class="blackjack-drawdeck">
                    <img src="~/images/pokercards/cardbackfinal.png" />
                </div>
                cardCount -= 13;
            } *@
        </div>
    </div>
    <div class="col-3">
            <div>
                @foreach (var card in Model.dealer.Hand)
                {

                    @if (card.IsVisible)
                    {
                        <img class="blackjack-card " src=$"~/images/pokercards/{card.ImageName}" />
                    }
                    else
                    {
                        <img class="blackjack-card " src="~/images/pokercards/CardBackFinal.png" />
                    }
                    
                }
            </div>
    </div>
    <div class="col-3">
            @if (Model.dealer != null)
            {
                @(
                    await Html.RenderComponentAsync<DealerScoreComp>(RenderMode.Server, new
                    {
                        State = Model.state,
                         @* dealer = Model.dealer  *@
                    })
                                )
                
            }
    </div>
</div>

<div class="row">
    <div class="col-3">
            @* @(
                await Html.RenderComponentAsync<MoneyComp>(RenderMode.Server, new
                {
                    Funds = Model.player.Funds,
                    Change = Model.player.Change
                })
                ) *@
                <component type="typeof(MoneyComp)" render-mode="ServerPrerendered" param-Funds="Model.player.Funds" param-Change="Model.player.Change"/>
    </div>
    <div class="col-3">
        @if (Model.state == GameEnums.GameState.Betting)
        {
            @if (Model.player.Funds < 10)
            {
                <span class="display-3 text-danger">Out of money!</span>
            }
            @if (Model.player.Funds >= 10)
            {
         
                <button type="submit" name="changed" value="bet10" class="btn btn-primary" id="betButton10">
                             Bet $10
                </button>

            }
            @if (Model.player.Funds >= 20)
            {
                <button type="submit" name="changed" value="bet20" class="btn btn-primary" id="betButton20">
                    Bet $20
                </button>

            }
            @if (Model.player.Funds >= 50)
            {
                    <button type="submit" name="changed" value="bet50" class="btn btn-primary" id="betButton50">
                    Bet $50
                </button>

            }
        }

        @if (Model.state == GameEnums.GameState.Payout)
        {
            <HandResultComp Player="Model.player" Dealer="Model.dealer" />
        }
        @if (Model.state == GameEnums.GameState.Dealing
        || Model.state == GameEnums.GameState.Shuffling
        || Model.state == GameEnums.GameState.InProgress)
        {
            <MessageComp State="Model.state" Bet="Model.player.Bet" />
                @(
                    await Html.RenderComponentAsync<MessageComp>(RenderMode.Server, new
                    {
                        State = Model.state,
                        Bet = Model.player.Bet
                    })
                    )

        }
    </div>
</div>

<div class="row">
    <div class="col-3">
        @if (Model.state == GameEnums.GameState.NotStarted || Model.player.Funds < 10)
        {
            <button type="submit" name="changed" value="Start" class="btn btn-secondary" id="btn-start">
            Start Game!
            </button>
            <script>
                document.getElementById('btn-start').addEventListener('click', function () {
                    // Call a JavaScript function or make an AJAX request here
                    Model.InitializeHand();
                });

            </script>
        }
        @if (!Model.player.isBusted
        && Model.state == GameEnums.GameState.InProgress
        && !Model.player.Standing)
        {
                <button type="submit" name="changed" value="stand" class="btn btn-primary" id="btn-Stand">
                Stand
            </button>
                <button type="submit" name="changed" value="hit" class="btn btn-primary" id="btn-Hit">
                Hit
            </button>
            
            @if (Model.player.visibleScore >= 9
           && Model.player.visibleScore <= 11
           && Model.player.Hand.Count == 2
           && Model.player.Funds >= Model.player.Bet * 2)
            {
                <br />
                <button class="btn btn-warning" id="btn-Double">
                    Double Down
                </button>
                <script>
                    document.getElementById('btn-Double').addEventListener('click', function () {
                        // Call a JavaScript function or make an AJAX request here
                        Model.DoubleDown();
                    });

                </script>
            }
            @if (Model.dealer.HasAceShowing && !Model.player.HasInsurance)
            {
                <br />
                <button class="btn btn-warning" id="btn-Insurance">
                    Insurance ($@(Model.player.Bet / 2))
                </button>
                <script>
                    document.getElementById('btn-Insurance').addEventListener('click', function () {
                        // Call a JavaScript function or make an AJAX request here
                        Model.Insurance();
                    });

                </script>
            }
        }
        @if (Model.state == GameEnums.GameState.Payout)
        {
            <button class="btn btn-secondary" id="btn-NewHand">
                Keep Going!
            </button>
            <script>
                document.getElementById('btn-NewHand').addEventListener('click', function () {
                    // Call a JavaScript function or make an AJAX request here
                    Model.NewHand();
                });

            </script>
        }
    </div>
    <div class="col-3"´>
             @foreach (var card in Model.player.Hand)
                {

                    @if (card.IsVisible)
                {
                    string imageSrc = $"{@Url.Content("~/images/pokercards/")}{card.ImageName.ToLower()}";
                        <img class="blackjack-card" src=@imageSrc />
					
       
                    }
                    else
                    {
                    <img class="blackjack-card " src="~/images/pokercards/CardBackFinal.png" />
                    }
                }
            
    </div>
    <div class="col-3">
            <component type="typeof(ScoreComp)" render-mode="ServerPrerendered" param-State="Model.state" param-score="Model.player.visibleScore" />
    </div>
</div>
</form>